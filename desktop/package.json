{
  "name": "neurodiscovery-desktop",
  "version": "1.0.0",
  "description": "NeuroDiscovery cross-platform desktop client",
  "main": "main.js",
  "author": "NeuroDiscovery",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "patch:portable:win": "node scripts/patch-portable-progress.js",
    "prepare:runtime:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-bundled-runtime.ps1",
    "prepare:runtime:mac": "bash scripts/prepare-bundled-runtime-mac.sh",
    "dist:win": "npm run prepare:runtime:win && npm run patch:portable:win && electron-builder --win nsis portable zip",
    "dist:win:skip-runtime": "npm run patch:portable:win && electron-builder --win nsis portable zip",
    "dist:mac": "npm run prepare:runtime:mac && electron-builder --mac dmg zip",
    "dist:mac:skip-runtime": "electron-builder --mac dmg zip",
    "dist:mac:arm64": "python3 scripts/build-mac-arm64.py --variant full",
    "dist:mac:x64": "npm run prepare:runtime:mac && electron-builder --mac dmg zip --x64",
    "dist:mac:arm64:full": "python3 scripts/build-mac-arm64.py --variant full",
    "dist:mac:arm64:evaluation": "python3 scripts/build-mac-arm64.py --variant evaluation",
    "dist:mac:arm64:demo": "python3 scripts/build-mac-arm64.py --variant demo",
    "dist:mac:arm64:all": "python3 scripts/build-mac-arm64.py --variant all"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.neurodiscovery.desktop",
    "productName": "NeuroDiscovery",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "llm-settings.js",
      "llm-credentials.js",
      "model-library.js",
      "settings-restart.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*",
          "!*.zip"
        ]
      }
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
