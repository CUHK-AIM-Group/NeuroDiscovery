{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Case 2 Luna replay response envelope",
  "type": "object",
  "properties": {
    "message": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["assistant"]
        },
        "content": {
          "type": ["string", "null"]
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "type": {"type": "string", "enum": ["function"]},
              "function": {
                "type": "object",
                "properties": {
                  "name": {"type": "string"},
                  "arguments": {"type": "string"}
                },
                "required": ["name", "arguments"],
                "additionalProperties": false
              }
            },
            "required": ["id", "type", "function"],
            "additionalProperties": false
          }
        }
      },
      "required": ["role", "content", "tool_calls"],
      "additionalProperties": false
    },
    "finish_reason": {
      "type": "string",
      "enum": ["stop", "tool_calls", "length", "content_filter"]
    }
  },
  "required": ["message", "finish_reason"],
  "additionalProperties": false
}
